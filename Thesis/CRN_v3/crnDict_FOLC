// ================ Reactors and reservoirs ================ 
reactors
{
    PSR1 
    {
        type                PSR;
        volume              0.00000112; // [m^3]
        discharge           no; // *optional
        initialTemperature  300.0; // Initial Temperature [K] *optional
        pressure            101325.0; // Initial pressure [Pa] *optional
        initialElectronDensity 1e1; // Initial electron number density [#/cm^3] *optional
        composition
        {
            H2     1;
        }
    }

    PSR2 
    {
        type                PSR;
        volume              0.00001673; // [m^3]
        discharge           no; // *optional
        initialTemperature  2000.0; // Initial Temperature [K] *optional
        pressure            101325.0; // Initial pressure [Pa] *optional
        initialElectronDensity 1e1; // Initial electron number density [#/cm^3] *optional
        composition
        {
            O2     0.0178;
            N2     0.6419;
            H2O    0.2878; // added 0.0002
            H2     0.0253;
            OH     0.0148;
            H      0.0091;
            O      0.0035;
        }
    }

    PSR3
    {
        type                PSR;
        volume              0.000821; // [m^3]
        discharge           no; // *optional
        initialTemperature  623.8; // Initial Temperature [K] *optional
        pressure            101325.0; // Initial pressure [Pa] *optional
        initialElectronDensity 1e1; // Initial electron number density [#/cm^3] *optional
        composition
        {
            O2     0.219; // O2     0.1853;
            N2     0.781; // N2     0.7724;
            H2     0.0;   // H2     0.0022;
            H2O    0.0;   // H2O    0.0401;
        }
    }

    PSR4 
    {
        type                PSR;
        volume              0.00000056; // [m^3]
        discharge           no; // *optional
        initialTemperature  1457.8; // Initial Temperature [K] *optional
        pressure            101325.0; // Initial pressure [Pa] *optional
        initialElectronDensity 1e1; // Initial electron number density [#/cm^3] *optional
        composition
        {
            O2     0.219;   // O2     0.1000;
            N2     0.781;   // N2     0.7111;
            H2O    0.0;     // H2O    0.1684;
            H2     0.0;     // H2     0.0064;
            OH     0.0;     // OH     0.0054;
            H      0.0;     // H      0.0043;
            O      0.0;     // O      0.0044;
        }
    }

    PSR5 
    {
        type                PSR;
        volume              0.00534; // [m^3]
        discharge           no; // *optional
        initialTemperature  834.6; // Initial Temperature [K] *optional
        pressure            101325.0; // Initial pressure [Pa] *optional
        initialElectronDensity 1e1; // Initial electron number density [#/cm^3] *optional
        composition
        {
            O2     0.219;   // O2     0.1687;
            N2     0.781;   // N2     0.7623;
            H2O    0.0;     // H2O    0.0690; // added 0.001
        }
    }

    PSR6 
    {
        type                PSR;
        volume              0.00177; // [m^3]
        discharge           no; // *optional
        initialTemperature  834.6; // Initial Temperature [K] *optional
        pressure            101325.0; // Initial pressure [Pa] *optional
        initialElectronDensity 1e1; // Initial electron number density [#/cm^3] *optional
        composition
        {
            O2     0.219;   // O2     0.1687;
            N2     0.781;   // N2     0.7624;
            H2O    0.0;     // H2O    0.0689; // added 0.0009
        }
    }

    airInlet
    {
        type        reservoir;
        composition
        {
            O2     0.219;
            N2     0.781;
        }
    }

    fuelInlet
    {
        type        reservoir;
        composition
        {
            H2     1.0;
        }
    }

    outlet
    {
        type        reservoir;
        composition
        {
            N2     1.0;
        }
    }
}

massFlowControllers
{
    airI
    {
        start   airInlet;
        end     PSR3;
        value   0.0;
    }

    airII
    {
        start   airInlet;
        end     PSR5;
        value   0.0;
    }

    fuelI
    {
        start   fuelInlet;
        end     PSR1;
        value   0.0;
    }

    out
    {
        start   PSR6;
        end     outlet;
        value   0.0;
    }

    mA
    {
        start   PSR1;
        end     PSR2;
        value   0.0;
    }

    mB
    {
        start   PSR2;
        end     PSR3;
        value   0.0;
    }

    mC
    {
        start   PSR3;
        end     PSR2;
        value   0.0;
    }

    mD
    {
        start   PSR2;
        end     PSR5;
        value   0.0;
    }

    mE
    {
        start   PSR5;
        end     PSR2;
        value   0.0;
    }

    mF
    {
        start   PSR1;
        end     PSR4;
        value   0.0;
    }

    mG
    {
        start   PSR5;
        end     PSR4;
        value   0.0;
    }

    mH
    {
        start   PSR4;
        end     PSR5;
        value   0.0;
    }

    mI
    {
        start   PSR5;
        end     PSR6;
        value   0.0;
    }
}
