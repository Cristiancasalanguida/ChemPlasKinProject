// ================ Reactors and reservoirs ================ 
reactors
{
    ZAX 
    {
        type                PSR;
        volume              4.63e-05; // [m^3]
        discharge           no; // *optional
        initialTemperature  1575.8; // Initial Temperature [K] *optional
        pressure            101325.0; // Initial pressure [Pa] *optional
        initialElectronDensity 1e1; // Initial electron number density [#/cm^3] *optional
        composition
        {
            O2   0.2027;
            N2   0.7229;
            H2   0.0744;
        }
    }

    ORZ
    {
        type                PSR;
        volume              6.06e-04; // [m^3]
        discharge           no; // *optional
        initialTemperature  1971.4; // Initial Temperature [K] *optional
        pressure            101325.0; // Initial pressure [Pa] *optional
        initialElectronDensity 1e1; // Initial electron number density [#/cm^3] *optional
        composition
        {
            O2   0.1919;
            N2   0.6845;
            H2   0.1236;
        }
    }

    FLSW
    {
        type                PSR;
        volume              4.67e-05; // [m^3]
        discharge           no; // *optional
        initialTemperature  1959.3; // Initial Temperature [K] *optional
        pressure            101325.0; // Initial pressure [Pa] *optional
        initialElectronDensity 1e1; // Initial electron number density [#/cm^3] *optional
        composition
        {
            O2   0.1944;
            N2   0.6931;
            H2   0.1125;
        }
    }

    IRZ
    {
        type                PSR;
        volume              1.54e-03; // [m^3]
        discharge           no; // *optional
        initialTemperature  1813.2; // Initial Temperature [K] *optional
        pressure            101325.0; // Initial pressure [Pa] *optional
        initialElectronDensity 1e1; // Initial electron number density [#/cm^3] *optional
        composition
        {
            O2     0.219;
            N2     0.781;
        }
    }

    FLAX
    {
        type                PSR;
        volume              3.35e-04; // [m^3]
        discharge           no; // *optional
        initialTemperature  2027.5; // Initial Temperature [K] *optional
        pressure            101325.0; // Initial pressure [Pa] *optional
        initialElectronDensity 1e1; // Initial electron number density [#/cm^3] *optional
        composition
        {
            O2     0.219;
            N2     0.781;
        }
    }

    resI
    {
        type        reservoir;
        initialTemperature 680.39;
        composition
        {
            O2   0.2027;
            N2   0.7229;
            H2   0.0744;
        }
    }

    resII
    {
        type        reservoir;
        initialTemperature 667.30;
        composition
        {
            O2   0.1919;
            N2   0.6845;
            H2   0.1236;
        }
    }

    outlet
    {
        type        reservoir;
        composition
        {
            N2     1.0;
        }
    }
}

massFlowControllers
{
    m1
    {
        start   resI;
        end     ZAX;
        value   0.0;
    }

    m2FLSW
    {
        start   resII;
        end     FLSW;
        value   0.0;
    }

    m2ORZ
    {
        start   resII;
        end     ORZ;
        value   0.0;
    }

    mA
    {
        start   ZAX;
        end     FLSW;
        value   0.0;
    }

    mB
    {
        start   FLSW;
        end     ORZ;
        value   0.0;
    }

    mC
    {
        start   ORZ;
        end     FLSW;
        value   0.0;
    }

    mD
    {
        start   FLSW;
        end     FLAX;
        value   0.0;
    }

    mE
    {
        start   IRZ;
        end     FLSW;
        value   0.0;
    }

    mF
    {
        start   ZAX;
        end     IRZ;
        value   0.0;
    }

    mG
    {
        start   IRZ;
        end     ZAX;
        value   0.0;
    }

    mH
    {
        start   FLAX;
        end     IRZ;
        value   0.0;
    }

    mI
    {
        start   IRZ;
        end     FLAX;
        value   0.0;
    }

    mM
    {
        start   IRZ;
        end     outlet;
        value   0.0;
    }

    mN
    {
        start   FLAX;
        end     outlet;
        value   0.0;
    }
}
